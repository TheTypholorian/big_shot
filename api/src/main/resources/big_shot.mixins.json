{
  "required": true,
  "package": "net.typho.big_shot.api.mixin",
  "compatibilityLevel": "JAVA_25",
  "mixins": [
    "MutableComponentMixin"
  ],
  "client": [
    "client.SplashManagerMixin",
    "client.rendering.ssbo.GlCommandEncoderMixin",
    "client.rendering.ssbo.GlProgramMixin",
    "client.rendering.ssbo.UniformTypeMixin"
  ],
  "injectors": {
    "defaultRequire": 1,
    "injectionPoints": [
      "net.typho.big_shot.api.mixin.target.SwitchInjectionPoint",
      "net.typho.big_shot.api.mixin.target.TypeInjectionPoint"
    ]
  },
  "overwrites": {
    "requireAnnotations": true
  }
}